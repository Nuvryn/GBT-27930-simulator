# Pinned C-only LibVNCServer; no optional external libraries or source-tree writes.
set(VNC_ROOT "${ROOT}/third_party/libvncserver")
set(VNC_GEN "${CMAKE_CURRENT_BINARY_DIR}/generated/vnc")
set(_RFB_RFBCONFIG_H 1)
foreach(feature DIRENT_H ENDIAN_H FCNTL_H GETTIMEOFDAY GETHOSTBYNAME GETHOSTNAME INET_NTOA MEMMOVE MEMSET MKFIFO SELECT SOCKET STRCHR STRCSPN STRDUP STRERROR STRSTR NETINET_IN_H SYS_SOCKET_H SYS_STAT_H SYS_TIME_H SYS_TYPES_H SYS_WAIT_H SYS_UIO_H SYS_RESOURCE_H UNISTD_H VPRINTF MMAP FORK)
    set(LIBVNCSERVER_HAVE_${feature} 1)
endforeach()
foreach(type PID_T SIZE_T SOCKLEN_T)
    set(HAVE_LIBVNCSERVER_${type} 1)
endforeach()
set(LIBVNCSERVER_WITH_WEBSOCKETS 1)
include(TestBigEndian)
test_big_endian(LIBVNCSERVER_WORDS_BIGENDIAN)
set(FULL_PACKAGE_NAME "LibVNCServer")
set(LibVNCServer_VERSION "0.9.15")
set(LibVNCServer_VERSION_MAJOR 0)
set(LibVNCServer_VERSION_MINOR 9)
set(LibVNCServer_VERSION_PATCH 15)
configure_file("${VNC_ROOT}/include/rfb/rfbconfig.h.cmakein" "${VNC_GEN}/rfb/rfbconfig.h")
set(VNC_SOURCES)
foreach(source main rfbserver rfbregion auth sockets stats corre hextile rre translate cutpaste httpd cursor font draw selbox cargs ultra scale rfbssl_none websockets ws_decode)
    list(APPEND VNC_SOURCES "${VNC_ROOT}/src/libvncserver/${source}.c")
endforeach()
foreach(source vncauth sockets crypto_included sha1 d3des minilzo base64)
    list(APPEND VNC_SOURCES "${VNC_ROOT}/src/common/${source}.c")
endforeach()
add_library(gbt_vncserver STATIC ${VNC_SOURCES})
target_include_directories(gbt_vncserver SYSTEM PUBLIC "${VNC_ROOT}/include" "${VNC_GEN}")
target_include_directories(gbt_vncserver PRIVATE "${VNC_ROOT}/src/common" "${VNC_ROOT}/src/libvncserver")
target_compile_definitions(gbt_vncserver PRIVATE _DEFAULT_SOURCE)
# Serve approved embedded assets through the upstream HTTP parser, without runtime files.
set_source_files_properties("${VNC_ROOT}/src/libvncserver/httpd.c" PROPERTIES COMPILE_DEFINITIONS "fopen=ui_web_asset_open")
find_package(Python3 REQUIRED COMPONENTS Interpreter)
file(GLOB_RECURSE WEB_ASSETS CONFIGURE_DEPENDS "${ROOT}/third_party/novnc/core/*.js" "${ROOT}/third_party/novnc/vendor/*.js")
add_custom_command(OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/generated/web_assets.inc"
    COMMAND ${Python3_EXECUTABLE} "${ROOT}/scripts/embed_web_assets.py" "${CMAKE_CURRENT_BINARY_DIR}/generated/web_assets.inc"
    DEPENDS ${WEB_ASSETS} "${ROOT}/app/ui/web_index.html" "${ROOT}/scripts/embed_web_assets.py"
    VERBATIM)
