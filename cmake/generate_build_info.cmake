# Invoked on every build; SOURCE_DATE_EPOCH is honored by CMake for reproducible builds.
string(TIMESTAMP SIM_BUILD_TIME "%Y-%m-%dT%H:%M:%SZ" UTC)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(metadata "/* Generated by CMake; do not edit. */\n#ifndef SIM_BUILD_INFO_GENERATED_H\n#define SIM_BUILD_INFO_GENERATED_H\n#define SIM_BUILD_VERSION \"${SIM_VERSION}\"\n#define SIM_BUILD_TIME \"${SIM_BUILD_TIME}\"\n#define SIM_BUILD_TARGET \"${SIM_TARGET}\"\n#define SIM_BUILD_COMPILER \"${SIM_COMPILER}\"\n#endif\n")
file(WRITE "${OUTPUT_DIR}/sim_build_info_generated.h.tmp" "${metadata}")
configure_file("${OUTPUT_DIR}/sim_build_info_generated.h.tmp" "${OUTPUT_DIR}/sim_build_info_generated.h" COPYONLY)
file(REMOVE "${OUTPUT_DIR}/sim_build_info_generated.h.tmp")
